#!/bin/bash

## Description: Smart-merge news records (incl. images) from remote — schema-safe (TYPO3 9→13 compatible)
## Usage: sync-news [--staging|--production]
## Example: "ddev sync-news --production"
## ProjectTypes: typo3

# Merge strategy:
#   tx_news_domain_model_news / tag / link   → REPLACE (production wins)
#   MM tables (news_tag, news_related, etc.) → scoped DELETE + REPLACE per news UID
#   sys_category                             → INSERT IGNORE (keep local)
#   sys_category_record_mm                  → scoped DELETE + REPLACE for news records
#   sys_file                                 → INSERT IGNORE (keep local file metadata)
#   sys_file_metadata                        → INSERT IGNORE (keep local)
#   sys_file_reference (tablenames=news)     → scoped DELETE + REPLACE per news UID
#   fileadmin/user_upload/                   → rsync (add new files, keep local)
#
# Schema-safety (TYPO3 9 → 13):
#   Each table is imported as per-row VALUES(...) statements using MySQL QUOTE()
#   on the remote — only the INTERSECTION of local (TYPO3 13) and remote (TYPO3 9)
#   column lists is included. Columns removed in TYPO3 10+ (e.g. t3ver_id,
#   t3ver_label) are silently skipped. New TYPO3 13 columns get their DB DEFAULTs.

set -e

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_info()    { printf "${BLUE}ℹ ${NC}%s\n" "$1"; }
print_success() { printf "${GREEN}✓${NC} %s\n" "$1"; }
print_error()   { printf "${RED}✗${NC} %s\n" "$1"; }
print_warning() { printf "${YELLOW}⚠${NC} %s\n" "$1"; }

CONFIG_FILE=".env.db-sync"

load_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        print_error "Configuration file '$CONFIG_FILE' not found!"
        print_info "Please copy '.env.db-sync.example' to '.env.db-sync' and configure it."
        exit 1
    fi
    set -a; source "$CONFIG_FILE"; set +a
    print_success "Configuration loaded from $CONFIG_FILE"
}

show_usage() {
    cat << EOF
${BLUE}TYPO3 News Smart-Merge (schema-safe, TYPO3 9→13 compatible)${NC}

Usage:
  ddev sync-news --staging      Merge news from staging into local DDEV
  ddev sync-news --production   Merge news from production into local DDEV
  ddev sync-news --help         Show this help

EOF
    exit 0
}

ENVIRONMENT=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --staging)    ENVIRONMENT="STAGING";    shift ;;
        --production) ENVIRONMENT="PRODUCTION"; shift ;;
        --help|-h)    show_usage ;;
        *) print_error "Unknown option: $1"; show_usage ;;
    esac
done

if [ -z "$ENVIRONMENT" ]; then
    print_error "No environment specified!"; echo ""; show_usage
fi

print_info "Starting news smart-merge from ${ENVIRONMENT}..."
echo ""

load_config

if [ "$ENVIRONMENT" == "STAGING" ]; then
    SSH_HOST="${STAGING_SSH_HOST}"
    SSH_USER="${STAGING_SSH_USER}"
    SSH_PORT="${STAGING_SSH_PORT:-22}"
    DB_NAME="${STAGING_DB_NAME}"
    DB_USER="${STAGING_DB_USER}"
    DB_PASSWORD="${STAGING_DB_PASSWORD}"
    DB_HOST="${STAGING_DB_HOST:-localhost}"
else
    SSH_HOST="${PRODUCTION_SSH_HOST}"
    SSH_USER="${PRODUCTION_SSH_USER}"
    SSH_PORT="${PRODUCTION_SSH_PORT:-22}"
    DB_NAME="${PRODUCTION_DB_NAME}"
    DB_USER="${PRODUCTION_DB_USER}"
    DB_PASSWORD="${PRODUCTION_DB_PASSWORD}"
    DB_HOST="${PRODUCTION_DB_HOST:-localhost}"
fi

REQUIRED_VARS=("SSH_HOST" "SSH_USER" "DB_NAME" "DB_USER" "DB_PASSWORD")
for var in "${REQUIRED_VARS[@]}"; do
    if [ -z "${!var}" ]; then
        print_error "Required variable ${ENVIRONMENT}_${var} is not set in $CONFIG_FILE"
        exit 1
    fi
done

LOCAL_DUMP_DIR="${LOCAL_DUMP_DIR:-.dumps}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
LOCAL_SQL="${LOCAL_DUMP_DIR}/news_merge_${TIMESTAMP}.sql.gz"
LOCAL_GENERATOR="/tmp/kfv_news_gen_${TIMESTAMP}.sh"
mkdir -p "$LOCAL_DUMP_DIR"

print_info "Configuration:"
echo "  Environment: ${ENVIRONMENT}"
echo "  Remote:      ${SSH_USER}@${SSH_HOST}:${SSH_PORT}"
echo "  Database:    ${DB_NAME}"
echo ""

# ---------------------------------------------------------------------------
# Step 1: Collect local TYPO3 13 column lists from DDEV
# ---------------------------------------------------------------------------
print_info "Step 1/5: Collecting local schema (TYPO3 13 column lists)..."

get_local_cols() {
    ddev mysql -N -e "SELECT GROUP_CONCAT(COLUMN_NAME ORDER BY ORDINAL_POSITION SEPARATOR '|')
        FROM information_schema.COLUMNS
        WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = '$1'" 2>/dev/null \
        | tr -d '\r'
}

LC_NEWS=$(get_local_cols "tx_news_domain_model_news")
LC_TAG=$(get_local_cols "tx_news_domain_model_tag")
LC_LINK=$(get_local_cols "tx_news_domain_model_link")
LC_SFR=$(get_local_cols "sys_file_reference")
LC_SF=$(get_local_cols "sys_file")
LC_SFM=$(get_local_cols "sys_file_metadata")
LC_CAT=$(get_local_cols "sys_category")
LC_CATMM=$(get_local_cols "sys_category_record_mm")
LC_NEWS_TAG=$(get_local_cols "tx_news_domain_model_news_tag_mm")
LC_NEWS_REL=$(get_local_cols "tx_news_domain_model_news_related_mm")
LC_NEWS_TTC=$(get_local_cols "tx_news_domain_model_news_ttcontent_mm")

print_success "Local schema collected ($(echo "$LC_NEWS" | tr '|' '\n' | wc -l | tr -d ' ') news columns)"

# ---------------------------------------------------------------------------
# Step 2: Build generator script (local col lists embedded, remote logic literal)
# ---------------------------------------------------------------------------
print_info "Step 2/5: Building and uploading SQL generator..."

# Part A — Header: local column lists are expanded HERE (double-quoted heredoc)
cat > "${LOCAL_GENERATOR}" << HEADER_EOF
#!/bin/bash
set -e
DB_HOST="\$1"; DB_USER="\$2"; DB_PASS="\$3"; DB_NAME="\$4"

# Column lists from local TYPO3 13 schema — embedded at generator-build time.
# Used to compute safe intersection with remote TYPO3 9 schema so that
# columns removed in TYPO3 10+ (e.g. t3ver_id, t3ver_label) are silently skipped.
LC_NEWS="${LC_NEWS}"
LC_TAG="${LC_TAG}"
LC_LINK="${LC_LINK}"
LC_SFR="${LC_SFR}"
LC_SF="${LC_SF}"
LC_SFM="${LC_SFM}"
LC_CAT="${LC_CAT}"
LC_CATMM="${LC_CATMM}"
LC_NEWS_TAG="${LC_NEWS_TAG}"
LC_NEWS_REL="${LC_NEWS_REL}"
LC_NEWS_TTC="${LC_NEWS_TTC}"
HEADER_EOF

# Part B — Logic: single-quoted heredoc, nothing expands locally.
# All \$vars here are remote-side bash variables.
cat >> "${LOCAL_GENERATOR}" << 'LOGIC_EOF'

MC="mysql -h $DB_HOST -u $DB_USER -p$DB_PASS $DB_NAME --batch --skip-column-names --silent"
BT='`'

# Get remote column list for a table (pipe-separated, ordered by ORDINAL_POSITION)
remote_cols() {
    $MC -e "SET SESSION group_concat_max_len=1000000;
            SELECT GROUP_CONCAT(COLUMN_NAME ORDER BY ORDINAL_POSITION SEPARATOR '|')
            FROM information_schema.COLUMNS
            WHERE TABLE_SCHEMA='$DB_NAME' AND TABLE_NAME='$1'" 2>/dev/null
}

# Return columns present in BOTH local_pipe AND remote_pipe (local order preserved)
col_intersect() {
    local local_pipe="$1" remote_pipe="$2" result="" col
    for col in $(echo "$local_pipe" | tr '|' '\n'); do
        [ -n "$col" ] || continue
        if echo "|${remote_pipe}|" | grep -qF "|${col}|"; then
            result="${result}|${col}"
        fi
    done
    echo "${result:1}"
}

# Generate schema-safe per-row VALUES-based INSERT statements.
# Data is embedded as QUOTE()-escaped literals so the SQL is self-contained
# and correct when applied to a DIFFERENT database (local DDEV).
# INSERT...SELECT is intentionally NOT used — it would read the local table.
#
# Args: tbl  local_cols_pipe  where_clause  REPLACE|IGNORE
gen_insert() {
    local tbl="$1" local_cols="$2" where="$3" mode="${4:-REPLACE}"

    local rc
    rc=$(remote_cols "$tbl")
    if [ -z "$rc" ] || [ "$rc" = "NULL" ]; then
        echo "-- SKIP $tbl: not found on remote" >&2; return
    fi

    local sc
    sc=$(col_intersect "$local_cols" "$rc")
    if [ -z "$sc" ]; then
        echo "-- SKIP $tbl: no column intersection" >&2; return
    fi

    # Build INSERT column list and per-column value expression.
    # Uses doubled-single-quote style ('' for apostrophes, \ stays literal)
    # so the output is compatible with NO_BACKSLASH_ESCAPES on the local import.
    # QUOTE() is intentionally NOT used: old MySQL versions do not escape backslashes
    # in QUOTE() output, producing \' which MySQL 8.0 misparses as end-of-string.
    local icols="" concat_expr="" col
    for col in $(echo "$sc" | tr '|' '\n'); do
        [ -n "$col" ] || continue
        icols="${icols},${BT}${col}${BT}"
        if [ -n "$concat_expr" ]; then
            concat_expr="${concat_expr},',',CONCAT('''',REPLACE(IFNULL(${BT}${col}${BT},''),'''',''''''),'''')"
        else
            concat_expr="CONCAT('''',REPLACE(IFNULL(${BT}${col}${BT},''),'''',''''''),'''')"
        fi
    done
    icols="${icols:1}"

    local wsql=""
    [ -n "$where" ] && wsql=" WHERE $where"

    local kw="REPLACE INTO"
    [ "$mode" = "IGNORE" ] && kw="INSERT IGNORE INTO"

    local cnt
    cnt=$($MC -e "SELECT COUNT(*) FROM ${BT}${tbl}${BT}${wsql}" 2>/dev/null || echo 0)

    echo "-- $tbl: $cnt row(s) [$mode, $(echo "$sc" | tr '|' '\n' | wc -l | tr -d ' ') columns]"
    if [ "${cnt:-0}" = "0" ]; then
        echo "-- (no rows to import)"
        return
    fi

    # One VALUES row per record — data comes from remote, not from local table
    $MC -e "SELECT CONCAT('$kw ${BT}${tbl}${BT} ($icols) VALUES (',$concat_expr,');') FROM ${BT}${tbl}${BT}${wsql}" 2>/dev/null | tr -d '\r'
}

# ── Main SQL ────────────────────────────────────────────────────────────────

$MC -e "SET SESSION group_concat_max_len=1000000" 2>/dev/null || true

NEWS_UIDS=$($MC -e "SELECT GROUP_CONCAT(uid ORDER BY uid) FROM tx_news_domain_model_news WHERE deleted=0" 2>/dev/null)
if [ -z "$NEWS_UIDS" ] || [ "$NEWS_UIDS" = "NULL" ]; then
    echo "-- ERROR: no non-deleted news records found on remote" >&2; exit 1
fi

NEWS_COUNT=$(echo "$NEWS_UIDS" | tr ',' '\n' | wc -l | tr -d ' ')

echo "-- KFV Freising: News smart-merge (schema-safe, TYPO3 9→13 compatible)"
echo "-- Generated:    $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
echo "-- Remote DB:    $DB_NAME @ $DB_HOST"
echo "-- News records: $NEWS_COUNT"
echo ""
echo "SET NAMES utf8mb4;"
echo "SET SESSION sql_mode = 'NO_BACKSLASH_ESCAPES';"
echo "SET FOREIGN_KEY_CHECKS = 0;"
echo "SET UNIQUE_CHECKS = 0;"
echo ""

# ── Scoped DELETEs ───────────────────────────────────────────────────────────
# Removes only relations that belong to the imported news UIDs so they can be
# cleanly replaced with fresh data from the remote.
echo "-- Scoped DELETEs (relations for imported news UIDs only)"
echo "DELETE FROM \`tx_news_domain_model_news_tag_mm\`       WHERE uid_local IN ($NEWS_UIDS);"
echo "DELETE FROM \`tx_news_domain_model_news_related_mm\`   WHERE uid_local IN ($NEWS_UIDS);"
echo "DELETE FROM \`tx_news_domain_model_news_ttcontent_mm\` WHERE uid_local IN ($NEWS_UIDS);"
echo "DELETE FROM \`sys_category_record_mm\`                 WHERE tablenames='tx_news_domain_model_news' AND uid_foreign IN ($NEWS_UIDS);"
echo "DELETE FROM \`sys_file_reference\`                     WHERE tablenames='tx_news_domain_model_news' AND uid_foreign IN ($NEWS_UIDS);"
echo "DELETE FROM \`tx_news_domain_model_link\`              WHERE parent IN ($NEWS_UIDS);"
echo ""

# ── News content (production wins) ───────────────────────────────────────────
echo "-- News records (production wins, deleted=0 only)"
gen_insert "tx_news_domain_model_news" "$LC_NEWS" "deleted=0"
echo ""

echo "-- Tags"
gen_insert "tx_news_domain_model_tag" "$LC_TAG" ""
echo ""

echo "-- Links (scoped to imported news)"
gen_insert "tx_news_domain_model_link" "$LC_LINK" "parent IN ($NEWS_UIDS)"
echo ""

# ── MM tables ────────────────────────────────────────────────────────────────
echo "-- MM: news <-> tags"
gen_insert "tx_news_domain_model_news_tag_mm" "$LC_NEWS_TAG" "uid_local IN ($NEWS_UIDS)"
echo ""

echo "-- MM: news <-> related"
gen_insert "tx_news_domain_model_news_related_mm" "$LC_NEWS_REL" "uid_local IN ($NEWS_UIDS)"
echo ""

echo "-- MM: news <-> tt_content"
gen_insert "tx_news_domain_model_news_ttcontent_mm" "$LC_NEWS_TTC" "uid_local IN ($NEWS_UIDS)"
echo ""

# ── sys_file_reference (news scope) ─────────────────────────────────────────
echo "-- sys_file_reference (news scope, INSERT after scoped DELETE)"
gen_insert "sys_file_reference" "$LC_SFR" \
    "tablenames='tx_news_domain_model_news' AND uid_foreign IN ($NEWS_UIDS)"
echo ""

# ── sys_file + metadata (INSERT IGNORE — never overwrite local records) ──────
FILE_UIDS=$($MC -e "
    SET SESSION group_concat_max_len=1000000;
    SELECT GROUP_CONCAT(DISTINCT uid_local ORDER BY uid_local)
    FROM sys_file_reference
    WHERE tablenames='tx_news_domain_model_news'
      AND uid_foreign IN ($NEWS_UIDS)" 2>/dev/null)

if [ -n "$FILE_UIDS" ] && [ "$FILE_UIDS" != "NULL" ]; then
    echo "-- sys_file (INSERT IGNORE — keep local file records if they exist)"
    gen_insert "sys_file" "$LC_SF" "uid IN ($FILE_UIDS)" "IGNORE"
    echo ""

    echo "-- sys_file_metadata (INSERT IGNORE)"
    gen_insert "sys_file_metadata" "$LC_SFM" "file IN ($FILE_UIDS)" "IGNORE"
    echo ""
fi

# ── sys_category (INSERT IGNORE — never overwrite local category data) ───────
CAT_UIDS=$($MC -e "
    SET SESSION group_concat_max_len=1000000;
    SELECT GROUP_CONCAT(DISTINCT uid_local ORDER BY uid_local)
    FROM sys_category_record_mm
    WHERE tablenames='tx_news_domain_model_news'
      AND uid_foreign IN ($NEWS_UIDS)" 2>/dev/null)

if [ -n "$CAT_UIDS" ] && [ "$CAT_UIDS" != "NULL" ]; then
    echo "-- sys_category (INSERT IGNORE — keep local categories)"
    gen_insert "sys_category" "$LC_CAT" "uid IN ($CAT_UIDS)" "IGNORE"
    echo ""

    echo "-- sys_category_record_mm (news scope)"
    gen_insert "sys_category_record_mm" "$LC_CATMM" \
        "tablenames='tx_news_domain_model_news' AND uid_foreign IN ($NEWS_UIDS)"
    echo ""
fi

echo "SET FOREIGN_KEY_CHECKS = 1;"
echo "SET UNIQUE_CHECKS = 1;"
LOGIC_EOF

chmod +x "${LOCAL_GENERATOR}"

# Upload generator to remote
scp -q -P "${SSH_PORT}" "${LOCAL_GENERATOR}" "${SSH_USER}@${SSH_HOST}:/tmp/kfv_news_gen_${TIMESTAMP}.sh"
rm -f "${LOCAL_GENERATOR}"
print_success "Generator uploaded"

# ---------------------------------------------------------------------------
# Step 3: Execute generator on remote, pipe SQL back
# ---------------------------------------------------------------------------
print_info "Step 3/5: Generating merge SQL on remote server (may take a moment)..."

ssh -p "${SSH_PORT}" "${SSH_USER}@${SSH_HOST}" \
    "bash /tmp/kfv_news_gen_${TIMESTAMP}.sh '${DB_HOST}' '${DB_USER}' '${DB_PASSWORD}' '${DB_NAME}' \
     && rm -f /tmp/kfv_news_gen_${TIMESTAMP}.sh" \
    2>/tmp/kfv_news_gen_stderr_${TIMESTAMP}.txt \
    | gzip > "${LOCAL_SQL}"

# Show any warnings from the generator
if [ -s "/tmp/kfv_news_gen_stderr_${TIMESTAMP}.txt" ]; then
    print_warning "Generator warnings:"
    grep -v "^$" /tmp/kfv_news_gen_stderr_${TIMESTAMP}.txt | sed 's/^/  /' || true
fi
rm -f "/tmp/kfv_news_gen_stderr_${TIMESTAMP}.txt"

# Clean up remote temp file (in case generator exited early)
ssh -p "${SSH_PORT}" "${SSH_USER}@${SSH_HOST}" \
    "rm -f /tmp/kfv_news_gen_${TIMESTAMP}.sh" 2>/dev/null || true

FILESIZE=$(du -h "${LOCAL_SQL}" | cut -f1)
print_success "Merge SQL generated and downloaded (${FILESIZE} compressed)"

# ---------------------------------------------------------------------------
# Step 4: Apply merge SQL to local DDEV database
# ---------------------------------------------------------------------------
print_info "Step 4/5: Applying news merge SQL to local DDEV database..."

gunzip < "${LOCAL_SQL}" | ddev mysql --default-character-set=utf8mb4

if [ $? -eq 0 ]; then
    print_success "News merge applied"
else
    print_error "Failed to apply merge SQL"
    print_info "Raw dump saved at: ${LOCAL_SQL} — inspect with: zcat ${LOCAL_SQL} | less"
    exit 1
fi

# ---------------------------------------------------------------------------
# Step 5: Rsync news image files + TYPO3 cache flush
# ---------------------------------------------------------------------------
print_info "Step 5/5: Syncing news image files (fileadmin/user_upload/)..."

# Remote fileadmin path: TYPO3 9 has no public/ subdir, webroot IS the project root.
# Override via PRODUCTION_REMOTE_FILEADMIN / STAGING_REMOTE_FILEADMIN in .env.db-sync.
if [ "$ENVIRONMENT" == "STAGING" ]; then
    REMOTE_FILEADMIN="${STAGING_REMOTE_FILEADMIN:-/var/www/html/fileadmin/user_upload/}"
else
    REMOTE_FILEADMIN="${PRODUCTION_REMOTE_FILEADMIN:-/var/www/html/fileadmin/user_upload/}"
fi

RSYNC_EXIT=0
rsync -az \
    -e "ssh -p ${SSH_PORT}" \
    "${SSH_USER}@${SSH_HOST}:${REMOTE_FILEADMIN}" \
    "public/fileadmin/user_upload/" || RSYNC_EXIT=$?

if [ "$RSYNC_EXIT" -eq 0 ]; then
    print_success "News image files synced"
else
    print_warning "File rsync failed (exit $RSYNC_EXIT) — images not synced."
    print_info "Set PRODUCTION_REMOTE_FILEADMIN in .env.db-sync to override the remote path."
    print_info "Current path tried: ${REMOTE_FILEADMIN}"
fi

ddev typo3 cache:flush 2>/dev/null || true
print_success "TYPO3 caches flushed"

echo ""
print_success "✓ News smart-merge from ${ENVIRONMENT} completed!"
echo ""
print_info "What was merged:"
echo "  • News, tags, links        → production wins (REPLACE)"
echo "  • MM relations             → scoped delete + reinsert"
echo "  • sys_file_reference       → scoped delete + reinsert (news scope only)"
echo "  • sys_file, sys_file_meta  → INSERT IGNORE (new files only)"
echo "  • sys_category             → INSERT IGNORE (new categories only)"
echo "  • fileadmin/user_upload/   → rsync (new files added, local kept)"
echo ""
print_info "Schema-safety: only columns present in BOTH TYPO3 9 (remote) and"
print_info "TYPO3 13 (local) were imported. Removed columns (t3ver_id etc.) skipped."
echo ""
print_info "SQL dump: ${LOCAL_SQL}"
print_warning "Delete old dumps in ${LOCAL_DUMP_DIR}/ to save space"
echo ""
