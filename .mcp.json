{
  "mcpServers": {
    "typo3": {
      "command": "ddev",
      "args": [
        "exec",
        "vendor/bin/typo3",
        "mcp:server"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@1.6.0",
        "--headless",
        "--isolated",
        "--chrome-arg=--no-sandbox",
        "--chrome-arg=--disable-setuid-sandbox",
        "--chrome-arg=--disable-gpu",
        "--chrome-arg=--disable-dev-shm-usage"
      ]
    }
  }
}
