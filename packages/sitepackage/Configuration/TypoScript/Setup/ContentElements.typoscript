lib.contentElement = FLUIDTEMPLATE
lib.contentElement {
    templateRootPaths {
        20 = {$styles.templates.templateRootPath}
    }
    partialRootPaths {
        20 = {$styles.templates.partialRootPath}
    }
    layoutRootPaths {
        20 = {$styles.templates.layoutRootPath}
    }
}


tt_content.section < lib.contentElement
tt_content.section {
    templateName = Section
    templateRootPaths {
        10 = EXT:sitepackage/Resources/Private/ContentElements/Templates
    }
    dataProcessing {
        20 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        20 {
            references.fieldName = image
        }
        200 = B13\Container\DataProcessing\ContainerProcessor
        200 {
            colPos = 200
            as = children_200
        }
    }
}

tt_content.2cols < lib.contentElement
tt_content.2cols {
    templateName = TwoColumns
    templateRootPaths {
        10 = EXT:sitepackage/Resources/Private/ContentElements/Templates
    }
    dataProcessing {
        10 = flex-form
        200 = B13\Container\DataProcessing\ContainerProcessor
        200 {
            colPos = 200
            as = children_200
        }
        201 = B13\Container\DataProcessing\ContainerProcessor
        201 {
            colPos = 201
            as = children_201
        }
    }
}

