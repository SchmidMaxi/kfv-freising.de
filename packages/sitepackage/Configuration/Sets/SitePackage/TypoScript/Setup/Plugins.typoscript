plugin.tx_news {
    settings {
        cssFile >
        defaultDetailPid = 38

        list {
            paginate {
                insertAbove = 0
                itemsPerPage = 9
            }
            media {
                dummyImage = EXT:sitepackage/Resources/Public/Images/Fallback-Images/news.jpg
                image {
                    maxHeight = 450c
                    maxWidth = 800c
                }
            }
        }

        detail {
            media {
                image {
                    maxHeight = 400c
                    maxWidth = 600c
                    lightbox {
                        enabled = 1
                        height = 1000m
                        width = 1900m
                    }
                }
            }
        }

    }
}
