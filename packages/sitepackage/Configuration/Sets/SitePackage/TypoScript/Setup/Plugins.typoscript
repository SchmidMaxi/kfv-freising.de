plugin.tx_calendarize {
    view {
        templateRootPaths {
            200 = EXT:sitepackage/Resources/Private/Extensions/Calendarize/Templates/
        }
        partialRootPaths {
            200 = EXT:sitepackage/Resources/Private/Extensions/Calendarize/Partials/
        }
        layoutRootPaths {
            200 = EXT:sitepackage/Resources/Private/Extensions/Calendarize/Layouts/
        }
    }
}

plugin.tx_mdfullcalendar {
    view {
        templateRootPaths {
            200 = EXT:sitepackage/Resources/Private/Extensions/MdFullcalendar/Templates/
        }
        partialRootPaths {
            200 = EXT:sitepackage/Resources/Private/Extensions/MdFullcalendar/Partials/
        }
        layoutRootPaths {
            200 = EXT:sitepackage/Resources/Private/Extensions/MdFullcalendar/Layouts/
        }
    }
}

plugin.tx_form {
    settings {
        yamlConfigurations {
            20 = EXT:sitepackage/Configuration/Yaml/FormSetup.yaml
        }
    }
}

plugin.tx_news {
    settings {
        cssFile >
        defaultDetailPid = 38

        list {
            paginate {
                insertAbove = 0
                itemsPerPage = 9
            }
            media {
                dummyImage = EXT:sitepackage/Resources/Public/Images/Fallback-Images/news.jpg
                image {
                    maxHeight = 450c
                    maxWidth = 800c
                }
            }
        }

        detail {
            media {
                image {
                    maxHeight = 400c
                    maxWidth = 600c
                    lightbox {
                        enabled = 1
                        height = 1000m
                        width = 1900m
                    }
                }
            }
        }

    }
}

# georgringer/news splits each list_type into its own top-level plugin
# (tx_news_newsliststicky, tx_news_newsdetail, ...) instead of the shared
# tx_news plugin. Without this, they fall back to the extension's default
# templates (wrong markup/classes, dummy image config lost).
plugin.tx_news_newsliststicky {
    settings =< plugin.tx_news.settings
    persistence =< plugin.tx_news.persistence
    view =< plugin.tx_news.view
}
plugin.tx_news_newsdetail {
    settings =< plugin.tx_news.settings
    persistence =< plugin.tx_news.persistence
    view =< plugin.tx_news.view
}
plugin.tx_news_newsselectedlist {
    settings =< plugin.tx_news.settings
    persistence =< plugin.tx_news.persistence
    view =< plugin.tx_news.view
}
plugin.tx_news_newsdatemenu {
    settings =< plugin.tx_news.settings
    persistence =< plugin.tx_news.persistence
    view =< plugin.tx_news.view
}
plugin.tx_news_categorylist {
    settings =< plugin.tx_news.settings
    persistence =< plugin.tx_news.persistence
    view =< plugin.tx_news.view
}
plugin.tx_news_newssearchform {
    settings =< plugin.tx_news.settings
    persistence =< plugin.tx_news.persistence
    view =< plugin.tx_news.view
}
plugin.tx_news_newssearchresult {
    settings =< plugin.tx_news.settings
