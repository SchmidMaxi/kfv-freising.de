# Each plugin has its own dedicated CType (feuerwehren_karte / _organigramm / _jubilaeen,
# see Configuration/TCA/Overrides/tt_content.php) rather than the classic CType=list +
# list_type convention, so none of the list_type CASE-dispatch shim is needed anymore.
# Core's own top-level "tt_content = CASE, key.field = CType" dispatch (untouched in v14)
# picks these up directly. Existing rows still carrying CType=list are migrated to their
# real CType by Classes/Updates/MigratePluginCTypeUpdate (run once via upgrade wizard).
tt_content.feuerwehren_karte = USER
tt_content.feuerwehren_karte {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = Feuerwehren
    pluginName = Karte
    vendorName = Schmid
}

tt_content.feuerwehren_organigramm = USER
tt_content.feuerwehren_organigramm {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = Feuerwehren
    pluginName = Organigramm
    vendorName = Schmid
}

tt_content.feuerwehren_jubilaeen = USER
tt_content.feuerwehren_jubilaeen {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = Feuerwehren
    pluginName = Jubilaeen
    vendorName = Schmid
}

# Vektor-Kachel Endpunkt für MapLibre
# Dieser Pfad wird vom VectorTileController bedient.
page.10.subparts.VECTOR_TILES_URL = TEXT
page.10.subparts.VECTOR_TILES_URL.value = /_vt/{z}/{x}/{y}.pbf