plugin.tx_feuerwehren {
    view {
        templateRootPaths.10 = EXT:feuerwehren/Resources/Private/Templates/
        partialRootPaths.10  = EXT:feuerwehren/Resources/Private/Partials/
        layoutRootPaths.10   = EXT:feuerwehren/Resources/Private/Layouts/
    }
}

tt_content.list.20.feuerwehren_karte = USER
