{
  "name": "schmid/feuerwehren",
  "description": "Feuerwehren: OSM/Leaflet map & org charts for TYPO3 13 LTS",
  "type": "typo3-cms-extension",
  "require": {
    "php": ">=8.4",
    "typo3/cms-core": "^13.4",
    "typo3/cms-frontend": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "Schmid\\Feuerwehren\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "feuerwehren",
      "routes": {
        "web": "Configuration/Routes.yaml"
      }
    }
  }
}
