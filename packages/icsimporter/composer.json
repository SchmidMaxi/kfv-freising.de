{
  "name": "schmid/icsimporter",
  "type": "typo3-cms-extension",
  "description": "Runs calendarize:import and assigns a sys_category to touched events",
  "require": {
    "typo3/cms-core": "^13.0",
    "lochmueller/calendarize": "^14.0"
  },
  "autoload": {
    "psr-4": {
      "Schmid\\IcsImporter\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "icsimporter"
    }
  }
}
