# Settings aus Site config.yaml übernehmen
plugin.tx_feuerwehren.settings {
    bboxW.data = site:settings.feuerwehren.bbox.west
    bboxS.data = site:settings.feuerwehren.bbox.south
    bboxE.data = site:settings.feuerwehren.bbox.east
    bboxN.data = site:settings.feuerwehren.bbox.north

    tileSource.data = site:settings.feuerwehren.tileSource
    mbtilesPath.data = site:settings.feuerwehren.mbtilesPath
    proxyUrl.data = site:settings.feuerwehren.proxyUrl
    proxyCacheMinutes.data = site:settings.feuerwehren.proxyCacheMinutes

    vectorTiles.enabled.data = site:settings.feuerwehren.vectorTiles.enabled
    vectorTiles.pbfPath.data = site:settings.feuerwehren.vectorTiles.pbfPath
}

# Plugins (wie bisher)
tt_content.list.20.feuerwehren_karte = USER
tt_content.list.20.feuerwehren_karte {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = Feuerwehren
    pluginName = Karte
}

tt_content.list.20.feuerwehren_organigramm = USER
tt_content.list.20.feuerwehren_organigramm {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = Feuerwehren
    pluginName = Organigramm
}

tt_content.list.20.feuerwehren_jubilaeen = USER
tt_content.list.20.feuerwehren_jubilaeen {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = Feuerwehren
    pluginName = Jubilaeen
}